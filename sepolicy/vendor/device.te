# Block devices
type carrier_block_device, dev_type;
type debug_block_device, dev_type;
type dsp_block_device, dev_type;
type dqmdbg_block_device, dev_type;
type efs_block_device, dev_type;
type omr_block_device, dev_type;
type param_block_device, dev_type;
type sec_efs_block_device, dev_type;
type spu_block_device, dev_type;
type steady_block_device, dev_type;
type vbmeta_block_device, dev_type;

# Fingerprint device
type fp_sensor_device, dev_type;

allow vendor_init tmpfs:dir create_dir_perms;

allow vendor_init cgroup:file rw_file_perms;

allow vendor_init efs_file:dir rw_dir_perms;
allow vendor_init spen_efs_file:dir create_dir_perms;

get_prop(vendor_init, vts_status_prop)
set_prop(vendor_init, vendor_ssr_prop)

dontaudit vendor_init cache_file:dir search;
dontaudit vendor_init default_prop:file read;

# UDFPS: init sets the finger mask brightness in /sys/class/lcd/panel
allow vendor_init vendor_sysfs_display:file w_file_perms;
